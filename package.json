{
  "name": "agent-eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "eval": "node src/cli.ts",
    "eval:smoke": "node src/cli.ts --suite e6-smoke --agent stub",
    "eval:full": "node src/cli.ts --suite e6-full --agent stub",
    "validate:e6c": "node --test --test-concurrency=1 tests/seed-suites.test.ts",
    "validate:e6a": "node src/seed-validation.ts",
    "validate:e6b": "node src/negative-seed-validation.ts",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:e7": "node --test --test-concurrency=1 tests/e7.test.ts",
    "validate:e7:docker": "node src/e7-docker-validation.ts",
    "eval:e7": "node src/cli.ts --suite e7-code --agent container",
    "validate:e8": "node --test --test-concurrency=1 tests/e8*.test.ts",
    "validate:e9": "node --test --test-concurrency=1 tests/e9*.test.ts",
    "validate:e10": "node --test --test-concurrency=1 tests/e10*.test.ts",
    "validate:e11": "node --test --test-concurrency=1 tests/e11*.test.ts",
    "validate:e12": "node --test --test-concurrency=1 tests/e12*.test.ts",
    "validate:e13": "node --test --test-concurrency=1 tests/e13*.test.ts"
  },
  "devDependencies": {
    "@types/node": "20.17.19",
    "typescript": "5.7.3"
  }
}
